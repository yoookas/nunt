# nunt docker compose 环境变量示例。
#
#   cp .env.example .env
#   # 按需修改，然后：
#   docker compose up -d
#
# docker compose 会自动读取同目录下的 .env；这个文件不要提交（已在 .gitignore 里）。

# 容器内进程的 uid/gid，建议与宿主机 ./data 的属主一致。
# 群晖等 NAS 上通常不是 1000，用 `id -u` / `id -g` 查。
PUID=1000
PGID=1000

# 时区（影响日志时间与证书续期调度）。
TZ=Asia/Shanghai

# 镜像名：源码构建时保持默认；从 Release 导入后改成 nunt:v1.0.0。
NUNT_IMAGE=nunt:dev

# 从源码构建时注入的版本号（只影响 docker image inspect 与 /api/v1/system/info）。
NUNT_VERSION=dev

# 管理后台监听地址。留空表示跟随 ./data/config.json（新卷默认 :3113）。
# 只临时换端口时：NUNT_ADMIN_LISTEN=:18080
# 注意：一旦设置，设置页里的地址字段会变成只读，想改回由控制台管理需要删掉这一行并重启。
# NUNT_ADMIN_LISTEN=
